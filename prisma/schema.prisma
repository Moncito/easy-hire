generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  role         Role     @default(SEEKER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  seekerProfile   SeekerProfile?
  company         Company?
  notifications   Notification[]
  messagesSent    Message[]
  exportAuditLogs ExportAuditLog[]

  @@map("users")
}

enum Role {
  SEEKER
  EMPLOYER
  ADMIN
}

enum ProfileVisibility {
  HIDDEN
  STANDARD
  PUBLIC
}

// ============================================================================
// SEEKER PROFILES
// ============================================================================

model SeekerProfile {
  id               String            @id @default(cuid())
  userId           String            @unique @map("user_id")
  fullName         String            @map("full_name")
  phone            String?
  location         String?
  headline         String?
  bio              String?
  resumeUrl        String?           @map("resume_url")
  skills           String[]
  desiredSalaryMin Int?              @map("desired_salary_min")
  desiredSalaryMax Int?              @map("desired_salary_max")
  visibility       ProfileVisibility @default(STANDARD)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  availability     String?           @map("availability")
  yearsExperience  String?           @map("years_experience")
  linkedinUrl      String?           @map("linkedin_url")
  portfolioUrl     String?           @map("portfolio_url")
  certifications   String[]          @default([])
  photoUrl         String?           @map("photo_url")
  languages        String[]          @default([])
  timezone         String?           @default("Asia/Manila")
  workExperience   String[]          @default([]) @map("work_experience")
  education        String[]          @default([])
  resumeLabel      String?           @map("resume_label")
  resumeUpdatedAt  DateTime?         @map("resume_updated_at")
  resumes          String[]          @default([])

  // Relations
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications  Application[]
  savedJobs     SavedJob[]
  jobAlerts     JobAlert[]
  conversations Conversation[]
  savedBy       SavedSeeker[]
  savedInLists  SavedTalentListItem[]

  @@map("seeker_profiles")
}

// ============================================================================
// COMPANIES & EMPLOYERS
// ============================================================================

model Company {
  id                          String             @id @default(cuid())
  userId                      String             @unique @map("user_id")
  companyName                 String             @map("company_name")
  logoUrl                     String?            @map("logo_url")
  bannerUrl                   String?            @map("banner_url")
  description                 String?
  website                     String?
  industry                    String?
  verifiedStatus              VerificationStatus @default(PENDING) @map("verified_status")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")
  teamSize                    String?            @map("team_size")
  foundedYear                 Int?               @map("founded_year")
  headquarters                String?
  highlights                  String[]           @default([])
  linkedinUrl                 String?            @map("linkedin_url")
  facebookUrl                 String?            @map("facebook_url")
  instagramUrl                String?            @map("instagram_url")
  xUrl                        String?            @map("x_url")
  verificationRejectionReason String?            @map("verification_rejection_reason")

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs                  Job[]
  subscriptions         Subscription[]
  conversations         Conversation[]
  savedSeekers          SavedSeeker[]
  verificationDocuments VerificationDocument[]
  aiUsageEvents         AiUsageEvent[]
  savedTalentLists      SavedTalentList[]
  analyticsDailyRollups AnalyticsDailyRollup[]
  exportAuditLogs       ExportAuditLog[]

  @@index([verifiedStatus])
  @@map("companies")
}

// ============================================================================
// EMPLOYER VERIFICATION (Sprint 7-8)
// ============================================================================

model VerificationDocument {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  fileUrl    String   @map("file_url")
  fileName   String   @map("file_name")
  docType    String   @map("doc_type") // BUSINESS_REGISTRATION | BUSINESS_PERMIT | OTHER
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("verification_documents")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// JOB POSTINGS
// ============================================================================

model Job {
  id                    String         @id @default(cuid())
  companyId             String         @map("company_id")
  title                 String
  description           String
  requirements          String?
  benefits              String?
  category              String
  industry              String?
  employmentType        EmploymentType @map("employment_type")
  salaryMin             Int?           @map("salary_min")
  salaryMax             Int?           @map("salary_max")
  salaryPeriod          SalaryPeriod   @default(MONTHLY) @map("salary_period")
  location              String
  remoteType            RemoteType     @default(REMOTE) @map("remote_type")
  status                JobStatus      @default(DRAFT)
  targetHireCount       Int            @default(1) @map("target_hire_count")
  publishedAt           DateTime?      @map("published_at")
  reviewRejectionReason String?        @map("review_rejection_reason")
  featuredUntil         DateTime?      @map("featured_until")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  expiresAt             DateTime?      @map("expires_at")

  // Relations
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications       Application[]
  savedJobs          SavedJob[]
  conversations      Conversation[]
  screeningQuestions ScreeningQuestion[]
  views              JobView[]

  @@index([companyId])
  @@index([industry])
  @@index([status])
  @@index([companyId, status])
  @@index([featuredUntil])
  @@map("jobs")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum RemoteType {
  REMOTE
  ONSITE
  HYBRID
}

enum SalaryPeriod {
  HOURLY
  MONTHLY
  ANNUAL
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  CLOSED
}

model JobView {
  id          String   @id @default(cuid())
  jobId       String   @map("job_id")
  viewedAt    DateTime @default(now()) @map("viewed_at")
  sessionHash String?  @map("session_hash")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, viewedAt])
  @@map("job_views")
}

// ============================================================================
// APPLICATIONS
// ============================================================================

model Application {
  id              String            @id @default(cuid())
  jobId           String            @map("job_id")
  seekerId        String            @map("seeker_id")
  status          ApplicationStatus @default(APPLIED)
  coverNote       String?           @map("cover_note")
  internalNotes   String?           @map("internal_notes")
  rating          Int?
  rejectionReason String?           @map("rejection_reason")
  appliedAt       DateTime          @default(now()) @map("applied_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  job     Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker  SeekerProfile       @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  answers ApplicationAnswer[]

  @@unique([jobId, seekerId])
  @@index([jobId])
  @@index([seekerId])
  @@index([status])
  @@index([jobId, status])
  @@map("applications")
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

// ============================================================================
// SCREENING QUESTIONS (Sprint 7-8) — answers are collected only, no knockout
// ============================================================================

model ScreeningQuestion {
  id        String  @id @default(cuid())
  jobId     String  @map("job_id")
  prompt    String
  required  Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  // Relations
  job     Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers ApplicationAnswer[]

  @@index([jobId])
  @@map("screening_questions")
}

model ApplicationAnswer {
  id            String @id @default(cuid())
  applicationId String @map("application_id")
  questionId    String @map("question_id")
  answerText    String @map("answer_text")

  // Relations
  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([applicationId])
  @@map("application_answers")
}

// ============================================================================
// SAVED JOBS & ALERTS
// ============================================================================

model SavedJob {
  id       String   @id @default(cuid())
  seekerId String   @map("seeker_id")
  jobId    String   @map("job_id")
  savedAt  DateTime @default(now()) @map("saved_at")

  // Relations
  seeker SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([seekerId, jobId])
  @@map("saved_jobs")
}

model JobAlert {
  id        String         @id @default(cuid())
  seekerId  String         @map("seeker_id")
  keywords  String
  category  String?
  frequency AlertFrequency
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relations
  seeker SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@map("job_alerts")
}

enum AlertFrequency {
  DAILY
  WEEKLY
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String
  message    String
  readStatus Boolean  @default(false) @map("read_status")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readStatus])
  @@map("notifications")
}

// ============================================================================
// SUBSCRIPTIONS (Month 3)
// ============================================================================

model Subscription {
  id                   String             @id @default(cuid())
  companyId            String             @map("company_id")
  planType             String             @map("plan_type")
  status               SubscriptionStatus
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

enum SubscriptionPlan {
  FREE
  PRO
}

// ============================================================================
// MESSAGING (Sprint 5)
// ============================================================================

model Conversation {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  seekerId      String   @map("seeker_id")
  jobId         String?  @map("job_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seeker   SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  job      Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([companyId, seekerId])
  @@index([companyId])
  @@index([seekerId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderUserId   String    @map("sender_user_id")
  body           String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, readAt])
  @@map("messages")
}

// ============================================================================
// EMPLOYER TALENT BOOKMARKS (Sprint 5)
// ============================================================================

model SavedSeeker {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  seekerId  String   @map("seeker_id")
  savedAt   DateTime @default(now()) @map("saved_at")

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seeker  SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([companyId, seekerId])
  @@index([companyId])
  @@map("saved_seekers")
}

// ============================================================================
// EMPLOYER PRO — EASY AI USAGE
// ============================================================================

/**
 * One row per Easy AI generation call — used for usage metering and rate limiting context.
 */
model AiUsageEvent {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  feature   String
  tokens    Int?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, feature])
  @@index([companyId, createdAt])
  @@map("ai_usage_events")
}

// ============================================================================
// EMPLOYER PRO — SAVED TALENT LISTS (Pro collections; SavedSeeker stays as
// the simple bookmark used on Free)
// ============================================================================

model SavedTalentList {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   SavedTalentListItem[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("saved_talent_lists")
}

model SavedTalentListItem {
  id       String   @id @default(cuid())
  listId   String   @map("list_id")
  seekerId String   @map("seeker_id")
  note     String?
  addedAt  DateTime @default(now()) @map("added_at")

  // Relations
  list   SavedTalentList @relation(fields: [listId], references: [id], onDelete: Cascade)
  seeker SeekerProfile   @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([listId, seekerId])
  @@index([listId])
  @@index([seekerId])
  @@map("saved_talent_list_items")
}

// ============================================================================
// EMPLOYER PRO — ANALYTICS ROLLUPS (precomputed daily metrics for fast Reports)
// ============================================================================

model AnalyticsDailyRollup {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  date      DateTime @db.Date
  metrics   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, date])
  @@map("analytics_daily_rollups")
}

// ============================================================================
// EMPLOYER PRO — EXPORT AUDIT LOG
// ============================================================================

/**
 * Tracks who exported candidate data and when. `meta` never stores the raw
 * export payload (which contains seeker PII) — only counts/filters used to
 * build the export — so this log itself stays safe to retain indefinitely.
 */
model ExportAuditLog {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  kind      String
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("export_audit_logs")
}
