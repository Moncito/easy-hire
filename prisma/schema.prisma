generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  role         Role     @default(SEEKER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  seekerProfile SeekerProfile?
  company       Company?
  notifications Notification[]

  @@map("users")
}

enum Role {
  SEEKER
  EMPLOYER
  ADMIN
}

// ============================================================================
// SEEKER PROFILES
// ============================================================================

model SeekerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  fullName          String   @map("full_name")
  phone             String?
  location          String?
  headline          String?
  bio               String?
  resumeUrl         String?  @map("resume_url")
  skills            String[]
  desiredSalaryMin  Int?     @map("desired_salary_min")
  desiredSalaryMax  Int?     @map("desired_salary_max")
  profileVisibility Boolean  @default(true) @map("profile_visibility")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  savedJobs    SavedJob[]
  jobAlerts    JobAlert[]

  @@map("seeker_profiles")
}

// ============================================================================
// COMPANIES & EMPLOYERS
// ============================================================================

model Company {
  id             String              @id @default(cuid())
  userId         String              @unique @map("user_id")
  companyName    String              @map("company_name")
  logoUrl        String?             @map("logo_url")
  description    String?
  website        String?
  industry       String?
  verifiedStatus VerificationStatus  @default(PENDING) @map("verified_status")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs          Job[]
  subscriptions Subscription[]

  @@map("companies")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// JOB POSTINGS
// ============================================================================

model Job {
  id             String         @id @default(cuid())
  companyId      String         @map("company_id")
  title          String
  description    String
  category       String
  employmentType EmploymentType @map("employment_type")
  salaryMin      Int?           @map("salary_min")
  salaryMax      Int?           @map("salary_max")
  location       String
  remoteType     RemoteType     @default(REMOTE) @map("remote_type")
  status         JobStatus      @default(DRAFT)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  expiresAt      DateTime?      @map("expires_at")

  // Relations
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  savedJobs    SavedJob[]

  @@map("jobs")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum RemoteType {
  REMOTE
  ONSITE
  HYBRID
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  CLOSED
}

// ============================================================================
// APPLICATIONS
// ============================================================================

model Application {
  id        String            @id @default(cuid())
  jobId     String            @map("job_id")
  seekerId  String            @map("seeker_id")
  status    ApplicationStatus @default(APPLIED)
  coverNote String?           @map("cover_note")
  appliedAt DateTime          @default(now()) @map("applied_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  // Relations
  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([jobId, seekerId])
  @@map("applications")
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

// ============================================================================
// SAVED JOBS & ALERTS
// ============================================================================

model SavedJob {
  id       String   @id @default(cuid())
  seekerId String   @map("seeker_id")
  jobId    String   @map("job_id")
  savedAt  DateTime @default(now()) @map("saved_at")

  // Relations
  seeker SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([seekerId, jobId])
  @@map("saved_jobs")
}

model JobAlert {
  id        String         @id @default(cuid())
  seekerId  String         @map("seeker_id")
  keywords  String
  category  String?
  frequency AlertFrequency
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relations
  seeker SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@map("job_alerts")
}

enum AlertFrequency {
  DAILY
  WEEKLY
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String
  message    String
  readStatus Boolean  @default(false) @map("read_status")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ============================================================================
// SUBSCRIPTIONS (Month 3)
// ============================================================================

model Subscription {
  id                   String             @id @default(cuid())
  companyId            String             @map("company_id")
  planType             String             @map("plan_type")
  status               SubscriptionStatus
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}
