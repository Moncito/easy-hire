generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  // Lets hot read paths opt into a single SQL JOIN (relationLoadStrategy: "join")
  // instead of Prisma's default one-query-per-relation, which is costly when the
  // DB sits ~150ms away. Opt-in per query — default strategy is unchanged.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Transaction pooler (port 6543, pgbouncer=true) for app runtime — required
  // on serverless (Vercel), where each concurrent invocation opens its own
  // connection; the direct/session connection caps at 15 clients and gets
  // exhausted immediately under concurrency. Migrations use the direct
  // connection instead, since pgbouncer transaction mode doesn't support the
  // advisory locks Prisma Migrate needs.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  role            Role      @default(SEEKER)
  avatarUrl       String?   @map("avatar_url")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  seekerProfile      SeekerProfile?
  company            Company?
  notifications      Notification[]
  messagesSent       Message[]
  exportAuditLogs    ExportAuditLog[]
  companyMemberships CompanyMember[]
  verificationTokens VerificationToken[]
  reviewsAuthored    Review[]

  @@map("users")
}

enum Role {
  SEEKER
  EMPLOYER
  ADMIN
}

enum ProfileVisibility {
  HIDDEN
  STANDARD
  PUBLIC
}

// ============================================================================
// PASSWORD RESET & EMAIL VERIFICATION
// ============================================================================

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id         String              @id @default(cuid())
  userId     String              @map("user_id")
  tokenHash  String              @unique @map("token_hash")
  purpose    VerificationPurpose
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// ============================================================================
// SEEKER PROFILES
// ============================================================================

model SeekerProfile {
  id               String                   @id @default(cuid())
  userId           String                   @unique @map("user_id")
  fullName         String                   @map("full_name")
  phone            String?
  location         String?
  headline         String?
  bio              String?
  resumeUrl        String?                  @map("resume_url")
  skills           String[]
  desiredSalaryMin Int?                     @map("desired_salary_min")
  desiredSalaryMax Int?                     @map("desired_salary_max")
  visibility       ProfileVisibility        @default(STANDARD)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  availability     String?                  @map("availability")
  yearsExperience  String?                  @map("years_experience")
  linkedinUrl      String?                  @map("linkedin_url")
  portfolioUrl     String?                  @map("portfolio_url")
  certifications   String[]                 @default([])
  photoUrl         String?                  @map("photo_url")
  languages        String[]                 @default([])
  timezone         String?                  @default("Asia/Manila")
  workExperience   String[]                 @default([]) @map("work_experience")
  education        String[]                 @default([])
  resumeLabel      String?                  @map("resume_label")
  resumeUpdatedAt  DateTime?                @map("resume_updated_at")
  resumes          String[]                 @default([])
  // Phase 4.2 — VA identity verification score. `idVerificationStatus` is
  // null until the seeker submits their first identity document (unlike
  // Company.verifiedStatus, which defaults to PENDING at creation) — see
  // lib/seeker/identity-verification.ts for the submit/review flow and
  // lib/seeker/verification-score.ts for how these feed verificationScore.
  // This score measures IDENTITY CONFIDENCE, not skill or work quality.
  idVerificationStatus           VerificationStatus? @map("id_verification_status")
  idVerifiedAt                   DateTime?           @map("id_verified_at")
  idVerificationRejectionReason  String?             @map("id_verification_rejection_reason")
  verificationScore              Int                 @default(0) @map("verification_score")
  verificationScoreUpdatedAt     DateTime?           @map("verification_score_updated_at")
  // SQL-only generated column (GENERATED ALWAYS AS ... STORED), created by
  // prisma/migrations/20260728210000_sprint5_messaging_talent. Prisma has no schema-level
  // concept of a STORED generated column, so this is declared as an Unsupported column
  // with a matching dbgenerated() default purely so introspection/diff tooling sees a
  // column here instead of nothing — it does NOT recreate the GENERATED ALWAYS AS
  // behavior and must never be the source of a migration for this column.
  searchVector     Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('english'::regconfig, COALESCE(full_name, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(headline, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(bio, ''::text)), 'C'::\"char\"))")) @map("search_vector")

  // Relations
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications    Application[]
  savedJobs       SavedJob[]
  jobAlerts       JobAlert[]
  conversations   Conversation[]
  savedBy         SavedSeeker[]
  savedInLists    SavedTalentListItem[]
  reviewsReceived Review[]
  identityDocuments SeekerIdentityDocument[]

  @@index([searchVector], type: Gin)
  @@index([idVerificationStatus])
  @@map("seeker_profiles")
}

// ============================================================================
// SEEKER IDENTITY VERIFICATION (Phase 4.2)
// ============================================================================

model SeekerIdentityDocument {
  id              String   @id @default(cuid())
  seekerProfileId String   @map("seeker_profile_id")
  fileUrl         String   @map("file_url") // object PATH in the private bucket, never a public URL
  fileName        String   @map("file_name")
  docType         String   @map("doc_type") // GOVERNMENT_ID | PROOF_OF_ADDRESS | SELFIE_WITH_ID | OTHER
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  @@index([seekerProfileId])
  @@map("seeker_identity_documents")
}

// ============================================================================
// COMPANIES & EMPLOYERS
// ============================================================================

model Company {
  id                          String             @id @default(cuid())
  userId                      String             @unique @map("user_id")
  companyName                 String             @map("company_name")
  logoUrl                     String?            @map("logo_url")
  bannerUrl                   String?            @map("banner_url")
  description                 String?
  website                     String?
  industry                    String?
  verifiedStatus              VerificationStatus @default(PENDING) @map("verified_status")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")
  teamSize                    String?            @map("team_size")
  foundedYear                 Int?               @map("founded_year")
  headquarters                String?
  highlights                  String[]           @default([])
  linkedinUrl                 String?            @map("linkedin_url")
  facebookUrl                 String?            @map("facebook_url")
  instagramUrl                String?            @map("instagram_url")
  xUrl                        String?            @map("x_url")
  verificationRejectionReason String?            @map("verification_rejection_reason")

  // Relations
  user                       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs                       Job[]
  subscriptions              Subscription[]
  conversations              Conversation[]
  savedSeekers               SavedSeeker[]
  verificationDocuments      VerificationDocument[]
  aiUsageEvents              AiUsageEvent[]
  savedTalentLists           SavedTalentList[]
  analyticsDailyRollups      AnalyticsDailyRollup[]
  exportAuditLogs            ExportAuditLog[]
  collaborativeHiringEnabled Boolean                @default(false) @map("collaborative_hiring_enabled")
  members                    CompanyMember[]
  invitations                CompanyInvitation[]
  reviewsReceived            Review[]

  // Denormalized public "response metrics" rollup (Phase 4.3), recomputed nightly by
  // runResponseMetricsForAllCompanies (lib/employer/response-metrics.ts) over a rolling
  // 90-day window of Application.firstEmployerResponseAt. responseRate/medianResponseMinutes
  // stay null until responseSampleSize clears the minimum-sample gate in computeResponseMetrics
  // — never publish a rate derived from a handful of applications.
  responseRate             Int?      @map("response_rate")
  medianResponseMinutes    Int?      @map("median_response_minutes")
  responseSampleSize       Int?      @map("response_sample_size")
  responseMetricsUpdatedAt DateTime? @map("response_metrics_updated_at")

  @@index([verifiedStatus])
  @@map("companies")
}

enum CompanyMemberRole {
  OWNER
  RECRUITER
  HIRING_MANAGER
  VIEWER
}

enum CompanyMemberStatus {
  ACTIVE
  REMOVED
}

model CompanyMember {
  id        String              @id @default(cuid())
  companyId String              @map("company_id")
  userId    String              @map("user_id")
  role      CompanyMemberRole
  status    CompanyMemberStatus @default(ACTIVE)
  invitedBy String?             @map("invited_by")
  joinedAt  DateTime            @default(now()) @map("joined_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobAssignments        JobTeamMember[]
  evaluations           CandidateEvaluation[]
  interviewAssignments  InterviewParticipant[]
  applicationActivities ApplicationActivity[]

  @@unique([companyId, userId])
  @@index([companyId, status])
  @@index([userId, status])
  @@map("company_members")
}

model CompanyInvitation {
  id         String            @id @default(cuid())
  companyId  String            @map("company_id")
  email      String
  role       CompanyMemberRole
  tokenHash  String            @unique @map("token_hash")
  expiresAt  DateTime          @map("expires_at")
  invitedBy  String            @map("invited_by")
  acceptedAt DateTime?         @map("accepted_at")
  revokedAt  DateTime?         @map("revoked_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, email])
  @@index([companyId, expiresAt])
  @@map("company_invitations")
}

// ============================================================================
// EMPLOYER VERIFICATION (Sprint 7-8)
// ============================================================================

model VerificationDocument {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  fileUrl    String   @map("file_url")
  fileName   String   @map("file_name")
  docType    String   @map("doc_type") // BUSINESS_REGISTRATION | BUSINESS_PERMIT | OTHER
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("verification_documents")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// JOB POSTINGS
// ============================================================================

model Job {
  id                    String                   @id @default(cuid())
  companyId             String                   @map("company_id")
  title                 String
  description           String
  requirements          String?
  benefits              String?
  category              String
  industry              String?
  employmentType        EmploymentType           @map("employment_type")
  salaryMin             Int?                     @map("salary_min")
  salaryMax             Int?                     @map("salary_max")
  salaryPeriod          SalaryPeriod             @default(MONTHLY) @map("salary_period")
  location              String
  remoteType            RemoteType               @default(REMOTE) @map("remote_type")
  status                JobStatus                @default(DRAFT)
  targetHireCount       Int                      @default(1) @map("target_hire_count")
  publishedAt           DateTime?                @map("published_at")
  reviewRejectionReason String?                  @map("review_rejection_reason")
  featuredUntil         DateTime?                @map("featured_until")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  expiresAt             DateTime?                @map("expires_at")
  // SQL-only generated column (GENERATED ALWAYS AS ... STORED), created by
  // prisma/migrations/20260727200000_sprint1_job_application_fields. Prisma has no
  // schema-level concept of a STORED generated column, so this is declared as an
  // Unsupported column with a matching dbgenerated() default purely so introspection/diff
  // tooling sees a column here instead of nothing — it does NOT recreate the GENERATED
  // ALWAYS AS behavior and must never be the source of a migration for this column.
  searchVector          Unsupported("tsvector")? @default(dbgenerated("((((setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(category, ''::text)), 'C'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(requirements, ''::text)), 'C'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(benefits, ''::text)), 'D'::\"char\"))")) @map("search_vector")

  // Relations
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications       Application[]
  savedJobs          SavedJob[]
  conversations      Conversation[]
  screeningQuestions ScreeningQuestion[]
  views              JobView[]
  teamMembers        JobTeamMember[]
  scorecardTemplates ScorecardTemplate[]

  @@index([companyId])
  @@index([industry])
  @@index([status])
  @@index([companyId, status])
  @@index([featuredUntil])
  @@index([category])
  @@index([publishedAt])
  @@index([expiresAt])
  // Matches the public job board's default listing query (lib/jobs/public-listing.ts:
  // activeJobWhere()/buildOrderBy() default sort): WHERE status = 'ACTIVE' ORDER BY
  // featuredUntil DESC NULLS LAST, createdAt DESC, id DESC. `status` leads because it's
  // the one equality filter on this table that every public-board query applies (the
  // other filter, company.verifiedStatus, lives on the joined Company table and can't
  // be part of this composite); the remaining columns are ordered to mirror the ORDER BY
  // exactly so Postgres can walk the index instead of sorting. The hand-authored SQL
  // migration also adds NULLS LAST on featured_until to match the query precisely —
  // Prisma's index DSL can't express NULLS LAST, so this Prisma-level declaration only
  // captures the column list/direction (see migration for the exact DDL).
  @@index([status, featuredUntil(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  // GIN index on the SQL-only search_vector column above (same migration as the column).
  @@index([searchVector], type: Gin)
  @@map("jobs")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum RemoteType {
  REMOTE
  ONSITE
  HYBRID
}

enum SalaryPeriod {
  HOURLY
  MONTHLY
  ANNUAL
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  CLOSED
}

model JobView {
  id          String   @id @default(cuid())
  jobId       String   @map("job_id")
  viewedAt    DateTime @default(now()) @map("viewed_at")
  sessionHash String?  @map("session_hash")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, viewedAt])
  @@map("job_views")
}

// ============================================================================
// APPLICATIONS
// ============================================================================

model Application {
  id              String            @id @default(cuid())
  jobId           String            @map("job_id")
  seekerId        String            @map("seeker_id")
  status          ApplicationStatus @default(APPLIED)
  coverNote       String?           @map("cover_note")
  internalNotes   String?           @map("internal_notes")
  rating          Int?
  rejectionReason String?           @map("rejection_reason")
  appliedAt       DateTime          @default(now()) @map("applied_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  // Set once, the first time this application transitions into HIRED (see
  // lib/jobs/applications.ts's updateApplication) — never overwritten on a
  // later re-hire, because it anchors the 14-day two-way review window
  // (lib/reviews.ts) and `updatedAt` changes on every edit so it can't serve
  // that purpose.
  hiredAt         DateTime?         @map("hired_at")
  // Same stamp-once precedent as hiredAt above, but for the *first* employer
  // engagement with this candidate — powers the public "response rate /
  // median response time" metrics (Phase 4.3, lib/employer/response-metrics.ts).
  // `updatedAt` can't serve this because it also advances on internal notes
  // and ratings, and ApplicationActivity only covers the collaborative-hiring
  // path, not the plain employer flow. Stamped at exactly three sites — see
  // the doc comment on each: lib/jobs/applications.ts's updateApplication,
  // lib/collaborative-hiring-reviews.ts's updateCollaborativePipeline, and
  // lib/messaging/messages.ts's sendMessage. Never overwritten once set.
  firstEmployerResponseAt DateTime? @map("first_employer_response_at")

  // Relations
  job         Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker      SeekerProfile         @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  answers     ApplicationAnswer[]
  evaluations CandidateEvaluation[]
  interviews  Interview[]
  activities  ApplicationActivity[]
  reviews     Review[]

  @@unique([jobId, seekerId])
  @@index([jobId])
  @@index([seekerId])
  @@index([status])
  @@index([jobId, status])
  // Supports recomputeCompanyResponseMetrics's per-company load (lib/employer/
  // response-metrics.ts): for each of a company's job ids, "applications whose
  // appliedAt falls in the rolling 90-day window." `appliedAt`, not
  // `firstEmployerResponseAt`, is the second key because the WHERE clause
  // filters on the window bound — firstEmployerResponseAt is only *read* per
  // row (the grace-period/qualifying decision runs in computeResponseMetrics,
  // in JS, not in SQL) so indexing it wouldn't help this query's WHERE clause.
  @@index([jobId, appliedAt])
  @@map("applications")
}

model ApplicationActivity {
  id            String                  @id @default(cuid())
  applicationId String                  @map("application_id")
  type          ApplicationActivityType
  body          String?
  actorMemberId String?                 @map("actor_member_id")
  createdAt     DateTime                @default(now()) @map("created_at")

  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorMember CompanyMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_activities")
}

enum ApplicationActivityType {
  NOTE
  STAGE_CHANGE
}

// ============================================================================
// COLLABORATIVE HIRING — JOB TEAMS AND SCORECARDS
// ============================================================================

model JobTeamMember {
  id         String   @id @default(cuid())
  jobId      String   @map("job_id")
  memberId   String   @map("member_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  member CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([jobId, memberId])
  @@index([memberId, jobId])
  @@map("job_team_members")
}

model ScorecardTemplate {
  id           String   @id @default(cuid())
  jobId        String   @map("job_id")
  title        String   @default("Hiring scorecard")
  instructions String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  job         Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  criteria    ScorecardCriterion[]
  evaluations CandidateEvaluation[]

  @@index([jobId, isActive])
  @@map("scorecard_templates")
}

model ScorecardCriterion {
  id          String  @id @default(cuid())
  templateId  String  @map("template_id")
  label       String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")

  template ScorecardTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ratings  EvaluationRating[]

  @@index([templateId, sortOrder])
  @@map("scorecard_criteria")
}

enum EvaluationRecommendation {
  STRONG_NO
  NO
  YES
  STRONG_YES
}

model CandidateEvaluation {
  id             String                    @id @default(cuid())
  applicationId  String                    @map("application_id")
  memberId       String                    @map("member_id")
  templateId     String                    @map("template_id")
  recommendation EvaluationRecommendation?
  summary        String?
  submittedAt    DateTime?                 @map("submitted_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  member      CompanyMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  template    ScorecardTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ratings     EvaluationRating[]

  @@unique([applicationId, memberId])
  @@index([applicationId, submittedAt])
  @@index([memberId, submittedAt])
  @@map("candidate_evaluations")
}

model EvaluationRating {
  id           String @id @default(cuid())
  evaluationId String @map("evaluation_id")
  criterionId  String @map("criterion_id")
  score        Int

  evaluation CandidateEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  ScorecardCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
  @@map("evaluation_ratings")
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// interviews("application_id", "scheduled_at") also carries a partial unique index,
// `interviews_application_id_scheduled_at_scheduled_key`, scoped to WHERE status =
// 'SCHEDULED' (see prisma/migrations/20260825000000_interview_slot_unique_when_scheduled).
// Prisma's schema DSL has no support for filtered/partial unique indexes (only
// full-table @@unique) — attempted as part of this pass and deliberately not added:
// declaring a plain `@@unique([applicationId, scheduledAt])` here would (a) be
// semantically wrong, since it would also block re-scheduling after a CANCELLED
// interview, which the partial index intentionally allows, and (b) surfaced in
// `prisma migrate diff --from-schema-datamodel ... --to-schema-datasource ...` as a
// mismatch the diff engine would try to reconcile by dropping the real partial index
// and creating a full one in its place — exactly the drop this file exists to prevent.
// Left SQL-only on purpose; do not add a `@@unique` here without re-running that diff
// and confirming no DROP appears.
model Interview {
  id            String          @id @default(cuid())
  applicationId String          @map("application_id")
  scheduledAt   DateTime        @map("scheduled_at")
  durationMins  Int             @default(30) @map("duration_mins")
  format        String          @default("VIDEO")
  location      String?
  status        InterviewStatus @default(SCHEDULED)
  outcome       String?
  createdBy     String          @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  application  Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  participants InterviewParticipant[]

  @@index([applicationId, scheduledAt])
  @@index([scheduledAt, status])
  @@map("interviews")
}

model InterviewParticipant {
  id          String    @id @default(cuid())
  interviewId String    @map("interview_id")
  memberId    String    @map("member_id")
  notes       String?
  outcome     String?
  completedAt DateTime? @map("completed_at")

  interview Interview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  member    CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([interviewId, memberId])
  @@index([memberId, interviewId])
  @@map("interview_participants")
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

// ============================================================================
// SCREENING QUESTIONS (Sprint 7-8) — answers are collected only, no knockout
// ============================================================================

model ScreeningQuestion {
  id        String  @id @default(cuid())
  jobId     String  @map("job_id")
  prompt    String
  required  Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  // Relations
  job     Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers ApplicationAnswer[]

  @@index([jobId])
  @@map("screening_questions")
}

model ApplicationAnswer {
  id            String @id @default(cuid())
  applicationId String @map("application_id")
  questionId    String @map("question_id")
  answerText    String @map("answer_text")

  // Relations
  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([applicationId])
  @@map("application_answers")
}

// ============================================================================
// SAVED JOBS & ALERTS
// ============================================================================

model SavedJob {
  id       String   @id @default(cuid())
  seekerId String   @map("seeker_id")
  jobId    String   @map("job_id")
  savedAt  DateTime @default(now()) @map("saved_at")

  // Relations
  seeker SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([seekerId, jobId])
  @@map("saved_jobs")
}

model JobAlert {
  id         String         @id @default(cuid())
  seekerId   String         @map("seeker_id")
  keywords   String
  category   String?
  frequency  AlertFrequency
  lastSentAt DateTime?      @map("last_sent_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  // Relations
  seeker SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  // Supports the cron digest query: findMany({ where: { frequency, lastSentAt: ... } }).
  @@index([frequency, lastSentAt])
  @@map("job_alerts")
}

enum AlertFrequency {
  DAILY
  WEEKLY
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String
  message    String
  readStatus Boolean  @default(false) @map("read_status")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readStatus])
  @@map("notifications")
}

// ============================================================================
// SUBSCRIPTIONS (Month 3)
// ============================================================================

model Subscription {
  id                   String             @id @default(cuid())
  companyId            String             @map("company_id")
  planType             String             @map("plan_type")
  status               SubscriptionStatus
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

enum SubscriptionPlan {
  FREE
  PRO
}

// ============================================================================
// MESSAGING (Sprint 5)
// ============================================================================

model Conversation {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  seekerId      String   @map("seeker_id")
  jobId         String?  @map("job_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seeker   SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  job      Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([companyId, seekerId])
  @@index([companyId])
  @@index([seekerId])
  @@map("conversations")
}

// This table is added to the `supabase_realtime` publication so the server-side
// Realtime subscription can broadcast INSERTs for live message delivery (see
// lib/messaging/messages.ts / lib/collaborative-messages.ts). Prisma's schema DSL has no
// representation for Postgres publications at all — there is nothing to declare here.
// The publication is created/maintained purely in SQL:
// prisma/migrations/20260826020000_enable_messages_realtime/migration.sql. Verify it's
// still attached to `public.messages` after any migration that touches this table.
model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderUserId   String    @map("sender_user_id")
  body           String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, readAt])
  @@map("messages")
}

// ============================================================================
// EMPLOYER TALENT BOOKMARKS (Sprint 5)
// ============================================================================

model SavedSeeker {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  seekerId  String   @map("seeker_id")
  savedAt   DateTime @default(now()) @map("saved_at")

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seeker  SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([companyId, seekerId])
  @@index([companyId])
  @@map("saved_seekers")
}

// ============================================================================
// EMPLOYER PRO — EASY AI USAGE
// ============================================================================

/**
 * One row per Easy AI generation call — used for usage metering and rate limiting context.
 */
model AiUsageEvent {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  feature   String
  tokens    Int?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, feature])
  @@index([companyId, createdAt])
  @@map("ai_usage_events")
}

// ============================================================================
// EMPLOYER PRO — SAVED TALENT LISTS (Pro collections; SavedSeeker stays as
// the simple bookmark used on Free)
// ============================================================================

model SavedTalentList {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   SavedTalentListItem[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("saved_talent_lists")
}

model SavedTalentListItem {
  id       String   @id @default(cuid())
  listId   String   @map("list_id")
  seekerId String   @map("seeker_id")
  note     String?
  addedAt  DateTime @default(now()) @map("added_at")

  // Relations
  list   SavedTalentList @relation(fields: [listId], references: [id], onDelete: Cascade)
  seeker SeekerProfile   @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([listId, seekerId])
  @@index([listId])
  @@index([seekerId])
  @@map("saved_talent_list_items")
}

// ============================================================================
// EMPLOYER PRO — ANALYTICS ROLLUPS (precomputed daily metrics for fast Reports)
// ============================================================================

model AnalyticsDailyRollup {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  date      DateTime @db.Date
  metrics   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, date])
  @@map("analytics_daily_rollups")
}

// ============================================================================
// EMPLOYER PRO — EXPORT AUDIT LOG
// ============================================================================

/**
 * Tracks who exported candidate data and when. `meta` never stores the raw
 * export payload (which contains seeker PII) — only counts/filters used to
 * build the export — so this log itself stays safe to retain indefinitely.
 */
model ExportAuditLog {
  id        String   @id @default(cuid())
  companyId String?  @map("company_id")
  userId    String   @map("user_id")
  kind      String
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@map("export_audit_logs")
}

// ============================================================================
// TWO-WAY REVIEWS (Phase 4.1)
// ============================================================================
//
// Reviews unlock only from an Application that reached HIRED — that
// proof-of-relationship anchor is what makes them non-gameable. Two nullable
// subject FKs (subjectCompanyId / subjectSeekerId) are used instead of a
// polymorphic subjectType/subjectId pair specifically because
// lib/account/account-deletion.ts anonymizes Company/SeekerProfile rows IN
// PLACE (keeps the id) rather than hard-deleting them, so real FK references
// stay valid and a user's reviews survive their own account deletion intact.
// A polymorphic id would carry no such referential integrity.
//
// Double-blind reveal: both `Review` rows for one application stay
// PENDING_REVEAL until either (a) both sides have submitted, or (b) the
// 14-day window off Application.hiredAt expires — see lib/reviews.ts for how
// the simultaneous-submission race is handled (Serializable isolation) and
// the reveal sweep for (b).

enum ReviewDirection {
  SEEKER_TO_COMPANY
  COMPANY_TO_SEEKER
}

enum ReviewStatus {
  PENDING_REVEAL
  PUBLISHED
  DISPUTED
  HIDDEN
}

model Review {
  id               String          @id @default(cuid())
  applicationId    String          @map("application_id")
  authorUserId     String          @map("author_user_id")
  direction        ReviewDirection
  subjectCompanyId String?         @map("subject_company_id")
  subjectSeekerId  String?         @map("subject_seeker_id")
  rating           Int
  body             String
  status           ReviewStatus    @default(PENDING_REVEAL)
  submittedAt      DateTime        @default(now()) @map("submitted_at")
  revealedAt       DateTime?       @map("revealed_at")
  disputeReason    String?         @map("dispute_reason")
  disputedAt       DateTime?       @map("disputed_at")
  // Resolution fields — set once an admin acts on a DISPUTED review (see
  // lib/reviews.ts resolveDisputedReview). `resolvedByUserId` is a plain id,
  // not a relation, matching the existing "who did this" precedent of
  // CompanyInvitation.invitedBy / ApplicationActivity.actorMemberId elsewhere
  // in this schema — a review must never be able to cascade-delete if an
  // admin account is later removed, and a second FK-to-User relation here
  // would also require a disambiguating @relation name against `author`.
  resolvedAt       DateTime?       @map("resolved_at")
  resolvedByUserId String?         @map("resolved_by_user_id")
  resolutionNote   String?         @map("resolution_note")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  application    Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author         User           @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  subjectCompany Company?       @relation(fields: [subjectCompanyId], references: [id], onDelete: Cascade)
  subjectSeeker  SeekerProfile? @relation(fields: [subjectSeekerId], references: [id], onDelete: Cascade)

  @@unique([applicationId, direction])
  @@index([subjectCompanyId, status])
  @@index([subjectSeekerId, status])
  @@map("reviews")
}
