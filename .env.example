# Local dev and staging point at the STAGING Supabase project, never
# production. See plans/STAGING-AND-RELEASE.md.
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Optional second override for absolute links (emails, sitemap). NEXTAUTH_URL
# wins when both are set (lib/shared/app-url.ts).
APP_URL=
# Set to "staging" only if this file's DATABASE_URL is the staging project;
# it switches the local corner label from the red "LIVE database" warning.
# `npm run dev:staging` sets it automatically.
# LOCAL_DATABASE=staging

# Google OAuth - Get these from https://console.cloud.google.com/
GOOGLE_ID=
GOOGLE_SECRET=

# Resend (for emails)
RESEND_API_KEY=
EMAIL_FROM=EasyHire <onboarding@resend.dev>
# Outside production all mail goes to this inbox instead of the real
# recipient. On staging (Vercel Preview), if this is empty NO mail is sent.
# Ignored on the live site.
EMAIL_TEST_RECIPIENT=

# Supabase Storage (resumes + company logos)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (for payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Cron auth (fail-closed): required Bearer secret for /api/cron/* routes.
# Until this is set, all cron endpoints return 503.
CRON_SECRET=

# Easy AI — set OPENAI_API_KEY or ANTHROPIC_API_KEY to enable Easy AI features.
# Without at least one set, Easy AI stays dormant and every feature returns a
# structured "AI not configured" response instead of throwing. OpenAI is
# preferred when both are present (see lib/ai/provider.ts).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides — leave commented out to use the defaults; an empty
# value is NOT treated as unset (lib/ai/provider.ts, lib/ai/rate-limit.ts).
# EASY_AI_OPENAI_MODEL=gpt-4o-mini
# EASY_AI_ANTHROPIC_MODEL=
# EASY_AI_RATE_LIMIT_PER_HOUR=30

# Two-factor auth (TOTP) — AES-256-GCM key used to encrypt User.totpSecret
# at rest (lib/auth/two-factor.ts). Must be base64 and decode to exactly 32
# bytes; generate with `openssl rand -base64 32` (or, without openssl,
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# There is NO fallback: enrolling, confirming, or verifying a TOTP code
# throws immediately if this is missing or the wrong length, rather than
# ever storing a secret in plaintext. Treat it like a database credential —
# losing or rotating it locks out every already-enrolled user, since their
# stored secrets become undecryptable.
TOTP_ENCRYPTION_KEY=

# Upstash Redis (REST API) — used for Easy AI + app-wide rate limiting
# (lib/shared/rate-limit.ts) and some L3 caching (lib/redis.ts).
# Without these set, the rate limiter degrades to a per-instance in-memory
# Map, which provides NO real protection on serverless: every lambda
# instance gets its own counter, so an attacker fanned out across instances
# (or after a redeploy) effectively resets/bypasses the limit. Set these in
# every real deployment environment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=